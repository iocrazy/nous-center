[Unit]
Description=nous-center MOSS-Transcribe-Diarize ASR 微服务(SGLang Omni,独立 venv,2026-07-20)
# 不 Requires/PartOf nous-backend —— 独立进程/venv(sglang-omni 自带 torch 2.11+cu130 /
# transformers 5.6,与 backend 的 vllm 0.22/torch 2.11 钉两条独立升级轨,不牵扯,故隔离)。
# backend 经 HTTP(NOUS_MOSS_ASR_URL)调它做 ASR;它挂了转写主路返回 503(MOSS 已是唯一 ASR)。
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=heygo
Group=heygo
WorkingDirectory=/media/heygo/program/projects-code/repos/nous-center/infra/moss-asr
# 独立 venv + 全部 GPU/CUDA_HOME/PATH/端口 出口都在 start_serve.sh 里(sh 脚本启动,
# 进程 cmdline 干净,便于 cgroup 收束)。
ExecStart=/media/heygo/program/projects-code/repos/nous-center/infra/moss-asr/start_serve.sh
# UUID 钉到 index0 的 3090,**别落 Pro 6000**:Pro 6000 Blackwell GSP 固件有负载触发崩溃 bug
# (被压一把模型就 fullchip-reset 僵死、拖黑整机,见 infra/gpu/README.md)。裸 cuda:0 在
# PCI_BUS_ID 排序下随槽位变可能命中 Pro 6000 → 不可靠;UUID 绑定永远是这张 3090。start_serve.sh
# 里也 export 了同一 UUID(直接跑脚本时生效),这里再声明一份保证 systemd 路径同样钉死。
# 注意:与 nous-aligner 钉的那张 3090(GPU-78dcdbeb…)是两张不同的卡。
Environment=CUDA_DEVICE_ORDER=PCI_BUS_ID
Environment=CUDA_VISIBLE_DEVICES=GPU-2fd7c91c-af39-7b02-66b9-988331ce3bd7
Environment=NOUS_MOSS_ASR_PORT=8003
Environment=MODELS_ROOT=/media/heygo/program/models
Restart=on-failure
RestartSec=10
# 首次部署冷启会现场 nvcc 编译 sgl-kernel(数分钟);Type=simple 下 systemd 不按就绪门杀,
# 但给足超时余量,防未来若改 Type=notify 时冷启被误判超时。warm 之后 ~秒级起。
TimeoutStartSec=600
# sglang 常驻内存(host RAM,非显存)比 aligner 大;给 24G 上限防意外泄漏拖垮宿主。
MemoryMax=24G
# KillMode 用默认 control-group(不写 KillMode= 即此):停服时收整个 cgroup,连 sglang
# worker 子进程一起杀。SPIKE.md 记了教训——worker cmdline 不含 config 名,只杀主进程会留孤儿
# 占显存(实测累积 5 个孤儿吃掉 22GB)。control-group 天然根治,故生产 unit 无此问题。
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
